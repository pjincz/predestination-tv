<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/osd_focus_fill" /><corners android:radius="10dp" />
            <stroke android:width="3dp" android:color="@color/osd_accent" /></shape>
    </item>
    <item><shape><solid android:color="@color/osd_button" /><corners android:radius="10dp" />
        <stroke android:width="1dp" android:color="@color/osd_border" /></shape></item>
</selector>
